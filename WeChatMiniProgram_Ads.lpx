#!name = 微信小程序去广告 Pro
#!desc = 小程序广告清理：微信广告组件 / 广点通 / 穿山甲 / 优量汇 域名层拦截 + 100 条小程序定制接口规则 + 激进模式兜底。含「多人签」PC 端实抓规则。
#!author = c4
#!homepage = 
#!icon = 
#!openUrl = 
#!category = 去广告
#!tag = 微信, 小程序, 去广告
#!system = iOS, iPadOS
#!system_version = 
#!loon_version = 3.2.1(745)
#!date = 2026-11-19 15:05:00

##############################################################
# [Rule] 域名层拦截 —— 不需要 MitM，命中即断
# 原则: 只碰"广告专用域名"，不碰任何内容主域/登录域/支付域
##############################################################
[Rule]

# ── A. 微信广告组件（小程序 banner / 插屏 / 激励视频素材与缩略图）──
# 这三个是微信原生广告组件实际取流量的位置，挡掉后组件降级为空布局
DOMAIN, wxsnsdy.wxs.qq.com, REJECT
DOMAIN, wxsnsdythumb.wxs.qq.com, REJECT
DOMAIN, wxsmsdy.video.qq.com, REJECT
# 2026-11-19 实抓增量：激励视频广告素材，路径形如
#   /131/20210/snssvpdownload/SH/reserved/ads_svp_video__xxx.mp4
# 该域名实测只分发 ads_svp_video，不承载内容
DOMAIN, wxsmw.wxs.qq.com, REJECT

# ── B. 腾讯广告 广点通 / 优量汇 ──
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, gdtimg.com, REJECT
DOMAIN-SUFFIX, pgdt.gtimg.cn, REJECT
DOMAIN-SUFFIX, pgdt.gtimg.com, REJECT
DOMAIN-SUFFIX, ugdtimg.com, REJECT
# 曝光/点击上报端点。若发现小程序某页加载异常，先注释这一行再试
DOMAIN, e.qq.com, REJECT

# ── C. 穿山甲 / 巨量引擎（字节系广告 SDK）──
DOMAIN-SUFFIX, pangolin-sdk-toutiao.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao-b.com, REJECT
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT
DOMAIN-SUFFIX, csjplatform.com, REJECT
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-SUFFIX, pangle-ads.com, REJECT

# ── D. 百度联盟 ──
DOMAIN, mobads.baidu.com, REJECT
DOMAIN, cpro.baidu.com, REJECT
DOMAIN-SUFFIX, cpro.baidustatic.com, REJECT

# ── E. 归因 / 第三方统计（默认关。开了会影响小程序的埋点，可能触发风控）──
# DOMAIN-SUFFIX, talkingdata.com, REJECT
# DOMAIN-SUFFIX, umeng.com, REJECT
# DOMAIN-SUFFIX, gotui.com, REJECT

##############################################################
# [Rewrite] 接口层 —— 需要 MitM + 已信任证书
# reject        = 断开连接(404)，用于纯废请求
# reject-200    = 返回 200 空体，用于脚本/图片
# reject-dict   = 返回 200 + "{}"，用于期望 JSON 对象的接口（最常用）
# reject-array  = 返回 200 + "[]"，用于期望数组的接口
# response-body-json-del k = 保留响应，仅删除 JSON 中的字段 k
# 判断不了返回结构时，优先 reject-dict
##############################################################
[Rewrite]

###########################################
# ★ 多人签 —— 2026-11-19 PC 端 MITM 实抓结果
# 只命中一个广告位：首页轮播，接口返回 data.banners 数组。
# 保留 data 结构、只清空数组，避免小程序读 data.banners.length 报错。
###########################################
^https:\/\/xxtpy\.lovegcu\.xyz\/api\/home\/content response-body-json-replace data.banners []
# 实测业务接口，均不可拦（拦了白屏）：
#   /api/auth/login  /api/auth/refresh  /api/auth/school
#   /api/me/points   /api/notes/avatar
#   /api/courses/list /api/shuake/catalog

###########################################
# 激进模式 —— 全域名广告路径兜底
# 打开可一把梭掉大部分小程序的开屏/弹窗/横幅，
# 代价：会误伤"内容型 banner"（商品轮播、活动入口），个别小程序可能白屏。
# 默认关闭。建议只在单个小程序上临时开。
###########################################
#^https?:\/\/[^\/]+\/(?:api\/)?(?:v\d\/)?(?:ad|ads|advert|advertise|advertising)(?:\/|\?|$) reject-dict
#^https?:\/\/[^\/]+\/.*\/(?:splash|launch|startup|openScreen|guidePage)(?:\/|\?|$) reject-dict

