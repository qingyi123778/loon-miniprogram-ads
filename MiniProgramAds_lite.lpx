# ============================================================
# 验证用最小插件
# 目的：把变量降到最少，单独确认这条 Rewrite 到底能不能执行
#   [Rule]    1 条 —— 微信激励视频素材，域名层拦截，不需要 MitM
#   [Rewrite] 1 条 —— 多人签首页 banner，需要 MitM
#   [MitM]    1 个域名 —— 短到不可能被截断
# ============================================================

[Rule]
DOMAIN, wxsmw.wxs.qq.com, REJECT

[Rewrite]
^https:\/\/xxtpy\.lovegcu\.xyz\/api\/home\/content response-body-json-replace data.banners []

[MitM]
hostname = xxtpy.lovegcu.xyz
